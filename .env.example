# ローカル開発用 (.env にコピーして使用)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lab_recommend
SECRET_KEY=change-me-in-production-random-32-chars
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here
DEBUG=true

# Railway では DATABASE_URL は自動注入されるため不要
# 本番では APP_ENV=production DEBUG=false に変更

# OpenAI API (scripts/extract_labels_openai.py で使用)
# .env に実際のキーを設定してください。このファイルには書かないでください。
OPENAI_API_KEY=your-openai-api-key-here
